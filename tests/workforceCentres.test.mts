import test from 'node:test';
import assert from 'node:assert/strict';
import {siteError,readSavedSites} from '../modules/workforce-prototype/sites.ts';
import {demoSites,deviceFence,checkFence,seedAttendance} from '../modules/workforce-prototype/attendance.ts';
import {seedShifts,shiftError,paidHours,locations,type Shift} from '../modules/workforce-prototype/model.ts';
import {coverError,type CoverRequest} from '../modules/workforce-prototype/cover.ts';
test('custom centres validate names, coordinates and survive serialization',()=>{const site={...demoSites[0],id:'new',name:'New pool',tagCode:'RDP-NEW'};assert.equal(siteError(site,demoSites),null);assert.ok(siteError({...site,name:' orchard '},demoSites));assert.ok(siteError({...site,configured:true,latitude:91},demoSites));assert.ok(siteError({...site,radius:0},demoSites));assert.equal(readSavedSites(JSON.stringify([...demoSites,site]))?.length,5);assert.equal(readSavedSites('invalid'),null);assert.equal(readSavedSites(JSON.stringify([site,site])),null);});
test('unconfigured centres support simulation but refuse real GPS evidence',()=>{const site=demoSites[0],position={latitude:site.latitude,longitude:site.longitude,accuracy:10};assert.equal(checkFence(site,position).status,'Inside');assert.equal(deviceFence(site,position).status,'Unavailable');assert.equal(deviceFence({...site,configured:true},position).status,'Inside');});
test('new centre can be scheduled without being a hardcoded default',()=>{const shift={...seedShifts()[0],id:'new',personId:'',location:'New pool'};assert.ok(shiftError(shift,[],[]));assert.equal(shiftError(shift,[],[],[...locations,'New pool']),null);});
test('separate sessions at different centres exclude the three-hour travel gap',()=>{const sessions=seedShifts().filter(s=>s.personId==='p4'&&s.date==='2026-09-16');assert.equal(sessions.length,2);assert.equal(sessions.reduce((n,s)=>n+paidHours(s),0),6);assert.deepEqual(sessions.map(s=>s.location),['Orchard','Siglap']);});
test('editing centre settings cannot rewrite recorded clock evidence',()=>{const records=seedAttendance(seedShifts());const recorded=records[0].clockIn.site;const updated={...demoSites[0],name:'Renamed Orchard',latitude:1.4};assert.notEqual(recorded,updated);assert.equal(recorded.name,'Orchard');assert.equal(recorded.latitude,1.35);});
const a:Shift={id:'a',seriesId:'pair',personId:'p1',date:'2026-09-19',start:'09:00',end:'12:00',breakMinutes:0,location:'Orchard',title:'Weekend cover',team:'Coaching',published:true};const b={...a,id:'b',date:'2026-09-26'};
const request:CoverRequest={id:'r',shiftId:'a',shiftIds:['a','b'],originalPersonId:'p1',personId:'p2',status:'Pending'};
test('linked cover validates all sessions before either is reassigned',()=>{assert.equal(coverError(request,[a,b],[],locations,[]),null);assert.ok(coverError(request,[a,{...b,published:false}],[],locations,[]));assert.ok(coverError(request,[a,b],[],locations,['b']));assert.ok(coverError(request,[a,{...b,personId:'p3'}],[],locations,[]));assert.ok(coverError({...request,personId:'p6'},[a,b],[],locations,[]));});
test('cover rechecks leave and overlaps on the second week',()=>{const leave={id:'leave',personId:'p2',date:b.date,endDate:b.date,type:'Annual leave',reason:'Holiday',status:'Approved' as const};assert.ok(coverError(request,[a,b],[leave],locations,[]));assert.ok(coverError(request,[a,b,{...b,id:'other',personId:'p2'}],[],locations,[]));});
import {leaveApprovalError} from '../modules/workforce-prototype/model.ts';
test('coaching leave needs both a lesson plan and shift cover; hospitality needs no lesson plan',()=>{const leave={id:'l',personId:'p1',date:a.date,endDate:a.date,type:'Unpaid leave',reason:'Away',status:'Pending' as const};assert.ok(leaveApprovalError(leave,[]));assert.ok(leaveApprovalError({...leave,lessonPlanUrl:'blob:demo'},[a]));assert.equal(leaveApprovalError({...leave,lessonPlanUrl:'blob:demo'},[]),null);assert.equal(leaveApprovalError({...leave,personId:'p6'},[]),null);});
test('two linked sessions moved to overlapping times cannot be approved together',()=>{assert.ok(coverError(request,[a,{...b,date:a.date}],[],locations,[]));});
