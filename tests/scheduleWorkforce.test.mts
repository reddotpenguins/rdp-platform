import test from 'node:test';
import assert from 'node:assert/strict';
import {availabilityIntersects,rosterDayStatus,periodRange,blockToDraft,type AvailabilityRow,type SavedBlock} from '../lib/schedule-workforce.ts';
import {parseSingaporeShiftRange,type RosterShift} from '../lib/scheduling.ts';
const row:AvailabilityRow={id:'a',staff_profile_id:'coach',weekday:6,start_time:'12:00:00',end_time:'24:00:00',availability_status:'unavailable',effective_from:'2026-09-19',effective_to:'2026-09-19',notes:'rdp-roster-status:Sick leave',updated_at:'2026-09-16T00:00:00Z'};
test('PM availability covers midnight exactly and respects date/staff/weekday',()=>{assert.equal(availabilityIntersects(row,'2026-09-19T23:59:00+08:00','2026-09-20T00:00:00+08:00'),true);assert.equal(availabilityIntersects(row,'2026-09-20T00:00:00+08:00','2026-09-20T01:00:00+08:00'),false);assert.equal(availabilityIntersects(row,'2026-09-19T08:45:00+08:00','2026-09-19T12:00:00+08:00'),false);assert.equal(availabilityIntersects(row,'2026-09-19T08:45:00+08:00','2026-09-19T12:30:00+08:00'),true);assert.equal(availabilityIntersects({...row,weekday:5},'2026-09-19T14:00:00+08:00','2026-09-19T18:00:00+08:00'),false);});
test('database statuses distinguish sickness, availability and approved leave',()=>{assert.equal(rosterDayStatus('coach','2026-09-19','PM',[],[row],[]),'Sick leave');assert.equal(rosterDayStatus('other','2026-09-19','PM',[],[row],[]),'Not On Shift');assert.equal(rosterDayStatus('coach','2026-09-19','PM',[],[{...row,availability_status:'available'}],[]),'Available for work');assert.equal(rosterDayStatus('coach','2026-09-19','PM',[],[],[{staff_profile_id:'coach',starts_at:'2026-09-19T12:00:00+08:00',ends_at:'2026-09-20T00:00:00+08:00',reason:'Annual leave'}]),'On Leave');});
test('overnight assignments show On Shift on both calendar dates',()=>{const shift={id:'s',status:'published',startsAt:'2026-09-19T23:00:00+08:00',endsAt:'2026-09-20T01:00:00+08:00',assignments:[{staffProfileId:'coach',status:'assigned'}]} as RosterShift;assert.equal(rosterDayStatus('coach','2026-09-20','AM',[shift],[],[]),'On Shift');assert.equal(rosterDayStatus('coach','2026-09-20','PM',[shift],[],[]),'Not On Shift');});
test('SQL template times including seconds parse correctly; invalid dates fail',()=>{assert.deepEqual(parseSingaporeShiftRange('2026-09-19','08:45:00','12:30:00'),{startsAt:'2026-09-19T00:45:00.000Z',endsAt:'2026-09-19T04:30:00.000Z'});assert.throws(()=>parseSingaporeShiftRange('2026-02-30','09:00','12:00'));assert.throws(()=>parseSingaporeShiftRange('2026-09-19','25:00','26:00'));});
test('saved SQL block preserves exact times and resource IDs',()=>{const block={title:'Saturday',day_offset:5,start_time:'08:45:00',end_time:'11:45:00',work_location_id:'loc',required_manpower:1,colour:'#2563eb'} as SavedBlock;const shift=blockToDraft(block,'2026-09-14');assert.equal(shift.startsAt,'2026-09-19T08:45:00+08:00');assert.equal(shift.endsAt,'2026-09-19T11:45:00+08:00');assert.equal(shift.workLocationId,'loc');assert.equal(periodRange('2026-12-31','PM').endsAt,'2027-01-01T00:00:00+08:00');});
