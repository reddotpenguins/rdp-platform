import test from 'node:test';
import assert from 'node:assert/strict';
import {calculateCpf,type CpfProfile} from '../modules/workforce-prototype/cpf.ts';
import {checkFence,clockInError,autoCloseDue,attendanceTimesheet,demoSites,seedAttendance,shiftInstant,tagSite} from '../modules/workforce-prototype/attendance.ts';
import {seedShifts,type Shift} from '../modules/workforce-prototype/model.ts';
import {buildPayrollJournal} from '../modules/workforce-prototype/payroll-journal.ts';
const citizen:CpfProfile={birthMonth:'1990-01',residency:'citizen',prSince:'',election:'GG'};
const cpf=(wages:number,profile=citizen,month='2026-09')=>calculateCpf(month,Math.round(wages*100),profile);
test('2026 citizen full CPF, OW cap and net cost reconcile',()=>{const r=cpf(5000);assert.equal(r.employeeCents,100000);assert.equal(r.employerCents,85000);assert.equal(r.totalCents,185000);assert.equal(r.netCents,400000);assert.equal(r.costCents,585000);const high=cpf(9500);assert.equal(high.assessableCents,800000);assert.equal(high.totalCents,296000);assert.equal(high.netCents,790000);});
test('all five age bands use official 2026 full rates',()=>{for(const [birthMonth,employee,employer] of [['1990-01',20000,17000],['1968-01',18000,16000],['1963-01',12500,12500],['1958-01',7500,9000],['1950-01',5000,7500]] as const){const r=cpf(1000,{...citizen,birthMonth});assert.equal(r.employeeCents,employee);assert.equal(r.employerCents,employer);}});
test('age changes apply after the birthday month, including first-of-month birthdays',()=>{const p={...citizen,birthMonth:'1971-09'};assert.equal(cpf(1000,p,'2026-09').employeeCents,20000);assert.equal(cpf(1000,p,'2026-10').employeeCents,18000);});
test('low wages boundaries and total vs employee rounding',()=>{assert.equal(cpf(50).totalCents,0);assert.equal(cpf(50.01).employeeCents,0);assert.equal(cpf(500).totalCents,8500);assert.equal(cpf(501).employeeCents,0);assert.equal(cpf(600).employeeCents,6000);assert.equal(cpf(600).employerCents,10200);assert.equal(cpf(750).employeeCents,15000);assert.equal(cpf(750).totalCents,27800);assert.equal(cpf(750.01).totalCents,27800);assert.equal(cpf(752.50).employeeCents,15000);assert.equal(cpf(752.50).totalCents,27800);});
test('PR year 1 and year 2 GG/FG/FF tables',()=>{const year1={...citizen,residency:'pr' as const,prSince:'2026-01-12'};assert.equal(cpf(1000,year1).totalCents,9000);assert.equal(cpf(1000,{...year1,election:'FG'}).totalCents,22000);assert.equal(cpf(1000,{...year1,election:'FF'}).totalCents,37000);const year2={...year1,prSince:'2025-01-12'};assert.equal(cpf(1000,year2).totalCents,24000);assert.equal(cpf(1000,{...year2,election:'FG'}).totalCents,32000);assert.equal(cpf(1000,{...year2,birthMonth:'1963-01'}).totalCents,11000);});
test('PR anniversary switches in following month; conversion month needs manual review',()=>{const p={...citizen,residency:'pr' as const,prSince:'2025-09-12'};assert.equal(cpf(1000,p,'2026-09').totalCents,9000);assert.equal(cpf(1000,p,'2026-10').totalCents,24000);assert.ok(cpf(1000,{...p,prSince:'2026-09-12'}).error);assert.ok(cpf(1000,{...p,prSince:'2026-02-99'}).error);});
test('unsupported periods and invalid wages fail closed; non-SC/non-PR has no CPF',()=>{assert.ok(cpf(1000,citizen,'2027-01').error);assert.ok(cpf(-1).error);assert.ok(calculateCpf('2026-09',NaN,citizen).error);assert.equal(cpf(5000,{...citizen,residency:'foreign'}).totalCents,0);});
const site=demoSites[0];const inside={latitude:site.latitude,longitude:site.longitude,accuracy:10};
test('geofence distinguishes inside, outside, uncertain and unavailable fixes',()=>{assert.equal(checkFence(site,inside).status,'Inside');assert.equal(checkFence(site,{...inside,latitude:site.latitude+.005}).status,'Outside');assert.equal(checkFence(site,{...inside,accuracy:200}).status,'Uncertain');assert.equal(checkFence(site,null).status,'Unavailable');assert.equal(checkFence(site,{...inside,accuracy:-1}).status,'Unavailable');});
const shift:Shift={id:'demo-shift',personId:'p4',date:'2026-09-16',start:'08:00',end:'12:00',breakMinutes:30,location:'Orchard',title:'Learn to Swim',team:'Coaching',published:true};
test('clock-in enforces assigned location, publication and clock window',()=>{assert.equal(clockInError(shift,site,inside,shiftInstant(shift.date,'07:30'),[]),null);assert.ok(clockInError(shift,site,inside,shiftInstant(shift.date,'07:29'),[]));assert.ok(clockInError(shift,site,inside,shiftInstant(shift.date,'12:00'),[]));assert.ok(clockInError({...shift,published:false},site,inside,shiftInstant(shift.date,'09:00'),[]));assert.ok(clockInError(shift,demoSites[1],inside,shiftInstant(shift.date,'09:00'),[]));});
test('automatic clock-out has no fabricated location and is excluded from payroll until approval',()=>{const records=seedAttendance(seedShifts());const now='2026-09-16T12:00:00+08:00';const result=autoCloseDue(records,now);const alicia=result.find(r=>r.personId==='p1')!;assert.equal(alicia.review,'Pending');assert.equal(alicia.clockOut,null);assert.equal(alicia.autoEnd,now);assert.equal(attendanceTimesheet(alicia),null);const approved=attendanceTimesheet({...alicia,review:'Approved'});assert.equal(approved?.end,'12:00');assert.equal(result.find(r=>r.personId==='p6')?.review,'Open');assert.equal(autoCloseDue(result,now)[0],result[0]);});
test('duplicate shifts and already-open attendance are rejected',()=>{const records=seedAttendance(seedShifts());const s=records[0].shift;assert.ok(clockInError(s,records[0].clockIn.site,records[0].clockIn.position,'2026-09-16T10:00:00+08:00',records));assert.ok(clockInError(s,records[0].clockIn.site,records[0].clockIn.position,'2026-09-16T10:00:00+08:00',records.map(r=>({...r,review:'Approved'}))));});
test('NFC requires a registered exact checkpoint code',()=>{assert.equal(tagSite('RDP-ORCHARD-01',demoSites)?.id,'orchard');assert.equal(tagSite('RDP-ORCHARD-02',demoSites),null);});
const accounts={wages:'1',employerCpf:'2',cpfPayable:'3',netPayable:'4'};
test('QuickBooks journal balances employer expense with net wages and combined CPF liabilities',()=>{const p=buildPayrollJournal('2026-09',{grossCents:500000,employerCents:85000,employeeCents:100000},accounts);const debit=p.Line.filter(l=>l.JournalEntryLineDetail.PostingType==='Debit').reduce((s,l)=>s+Math.round(l.Amount*100),0);const credit=p.Line.filter(l=>l.JournalEntryLineDetail.PostingType==='Credit').reduce((s,l)=>s+Math.round(l.Amount*100),0);assert.equal(debit,585000);assert.equal(credit,debit);assert.equal(p.TxnDate,'2026-09-30');assert.equal(p.Line.find(l=>l.JournalEntryLineDetail.AccountRef.value==='3')?.Amount,1850);assert.equal(p.Line.find(l=>l.JournalEntryLineDetail.AccountRef.value==='4')?.Amount,4000);});
test('journal rejects unmapped accounts, duplicate mapping and invalid money',()=>{assert.throws(()=>buildPayrollJournal('2026-09',{grossCents:100,employeeCents:0,employerCents:0},{...accounts,wages:''}));assert.throws(()=>buildPayrollJournal('2026-09',{grossCents:100,employeeCents:0,employerCents:0},{...accounts,wages:'2'}));assert.throws(()=>buildPayrollJournal('2026-09',{grossCents:100,employeeCents:200,employerCents:0},accounts));});

test('PR senior G/G and F/G rates match all table age bands',()=>{for(const [birthMonth,firstGg,secondGg,firstFg,secondFg] of [['1990-01',9000,24000,22000,32000],['1968-01',9000,18500,21000,28500],['1963-01',8500,11000,17500,20000],['1958-01',8500,8500,14000,14000],['1950-01',8500,8500,12500,12500]] as const){const p={...citizen,birthMonth,residency:'pr' as const,prSince:'2026-01-12'};assert.equal(cpf(1000,p).totalCents,firstGg);assert.equal(cpf(1000,{...p,election:'FG'}).totalCents,firstFg);assert.equal(cpf(1000,{...p,prSince:'2025-01-12'}).totalCents,secondGg);assert.equal(cpf(1000,{...p,prSince:'2025-01-12',election:'FG'}).totalCents,secondFg);}});
