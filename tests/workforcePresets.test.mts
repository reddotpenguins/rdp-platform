import test from 'node:test';
import assert from 'node:assert/strict';
import {defaultPresets,presetShift,presetError,readPresets} from '../modules/workforce-prototype/schedule-presets.ts';
import {paidHours,shiftError} from '../modules/workforce-prototype/model.ts';
import {lateMinutes,seedAttendance,shiftInstant} from '../modules/workforce-prototype/attendance.ts';
import {seedShifts} from '../modules/workforce-prototype/model.ts';
test('presets preserve exact weekday, quarter-hour boundaries and different Saturday durations',()=>{const shifts=defaultPresets.map((p,i)=>presetShift(p,'2026-09-14',i?'Siglap':'Orchard',String(i)));assert.deepEqual(shifts.map(s=>[s.date,s.start,s.end,paidHours(s)]),[['2026-09-18','16:00','18:15',2.25],['2026-09-19','08:45','12:30',3.75],['2026-09-19','08:45','11:45',3]]);});
test('preset coach defaults and centre renaming work without mutating saved shifts',()=>{const p={...defaultPresets[0],personId:'p2'};const shift=presetShift(p,'2026-09-21','Renamed Orchard','new');assert.equal(shift.personId,'p2');assert.equal(shift.date,'2026-09-25');assert.equal(shift.location,'Renamed Orchard');p.end='19:00';assert.equal(shift.end,'18:15');assert.equal(shift.published,false);});
test('presets validate times and persist separate variants',()=>{assert.equal(readPresets(JSON.stringify(defaultPresets))?.length,3);assert.deepEqual(readPresets('[]'),[]);assert.equal(readPresets('{broken'),null);assert.ok(presetError({...defaultPresets[0],end:'15:00'}));assert.ok(presetError({...defaultPresets[0],weekday:7}));assert.ok(presetError({...defaultPresets[0],breakMinutes:135}));});
test('two alternative Saturday blocks cannot be assigned concurrently to one coach',()=>{const a=presetShift({...defaultPresets[1],personId:'p2'},'2026-09-14','Siglap','a');const b=presetShift({...defaultPresets[2],personId:'p2'},'2026-09-14','Siglap','b');assert.ok(shiftError(b,[a],[]));});
test('lateness uses the captured schedule, exact Singapore timestamps and zero grace',()=>{const r=seedAttendance(seedShifts())[0];assert.equal(lateMinutes(r),0);const arrival=(time:string)=>({...r,clockIn:{...r.clockIn,at:shiftInstant(r.shift.date,time)}});assert.equal(lateMinutes(arrival('07:59')),0);assert.equal(lateMinutes(arrival('08:01')),1);assert.equal(lateMinutes(arrival('08:07')),7);assert.equal(lateMinutes({...r,clockIn:{...r.clockIn,at:'2026-09-16T00:00:01Z'}}),1);assert.equal(lateMinutes({...r,clockIn:{...r.clockIn,at:'invalid'}}),null);});
