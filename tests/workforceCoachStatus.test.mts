import test from 'node:test';
import assert from 'node:assert/strict';
import {coachStatus,coachAssignmentError,type CoachDay} from '../modules/workforce-prototype/coach-status.ts';
import {seedShifts,seedLeave,type Shift} from '../modules/workforce-prototype/model.ts';
const day:CoachDay={personId:'p1',date:'2026-09-15',morning:'Available for work',afternoon:'Not On Shift'};
const shift:Shift={id:'x',personId:'p1',date:day.date,start:'09:00',end:'12:00',breakMinutes:0,location:'Orchard',title:'Coaching',team:'Coaching',published:false};
test('morning availability does not imply an afternoon shift or availability',()=>{assert.equal(coachStatus('p1',day.date,'Morning',[],[],[day]),'Available for work');assert.equal(coachStatus('p1',day.date,'Afternoon',[],[],[day]),'Not On Shift');assert.equal(coachStatus('p2',day.date,'Morning',[],[],[day]),'Not On Shift');});
test('on-shift follows actual assignments with an exact noon boundary',()=>{assert.equal(coachStatus('p1',day.date,'Morning',[shift],[],[day]),'On Shift');assert.equal(coachStatus('p1',day.date,'Afternoon',[shift],[],[day]),'Not On Shift');assert.equal(coachStatus('p1',day.date,'Morning',[{...shift,start:'12:00',end:'15:00'}],[],[day]),'Available for work');assert.equal(coachStatus('p1',day.date,'Afternoon',[{...shift,end:'12:01'}],[],[day]),'On Shift');});
test('approved medical leave and ordinary leave have distinct labels; pending leave does not block status',()=>{assert.equal(coachStatus('p3','2026-09-18','Morning',seedShifts(),seedLeave,[]),'On Leave');assert.equal(coachStatus('p3','2026-09-18','Afternoon',[],[{...seedLeave[0],type:'Medical leave'}],[]),'Sick leave');assert.equal(coachStatus('p5','2026-09-17','Morning',[],seedLeave,[]),'Not On Shift');});
test('sick and leave markers reject only overlapping periods for that coach and date',()=>{const sick={...day,morning:'Sick leave' as const};assert.ok(coachAssignmentError(shift,[sick]));assert.equal(coachAssignmentError({...shift,start:'12:00',end:'15:00'},[sick]),null);assert.equal(coachAssignmentError({...shift,personId:'p2'},[sick]),null);assert.equal(coachAssignmentError({...shift,date:'2026-09-16'},[sick]),null);assert.ok(coachAssignmentError({...shift,start:'11:00',end:'14:00'},[{...day,afternoon:'On Leave'}]));assert.equal(coachAssignmentError(shift,[day]),null);});
